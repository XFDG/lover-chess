{
  "name": "lover-chess",
  "version": "1.0.0",
  "description": "情侣飞行棋 · Love Flight Chess — 一款情侣双人飞行棋网页/桌面小游戏，支持 5 个难度。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "XFDG",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.xfdg.loverchess",
    "productName": "情侣飞行棋",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
